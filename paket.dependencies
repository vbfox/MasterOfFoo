source https://api.nuget.org/v3/index.json
framework: net10.0,net8.0,net5.0,netcoreapp2.0,netstandard2.0,net461
storage:none

nuget Expecto ~> 9
nuget FSharp.Core
nuget System.Data.SqlClient 4.8.6

// Build infrastructure
group build
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: net10.0

    nuget FSharp.Core
    nuget BlackFox.Fake.BuildTask
    nuget BlackFox.CommandLine

    // 18.x only ships net11.0 and net472 libs, so on net10.0 nothing is copied to the output and
    // FAKE's binlog parsing fails to load Microsoft.Build.Framework. 17.14 ships net9.0.
    nuget Microsoft.Build.Framework ~> 17.14
    nuget Microsoft.Build.Utilities.Core ~> 17.14
    nuget Microsoft.NET.StringTools ~> 17.14

    nuget Fake.Core.Target
    nuget Fake.Core.Environment
    nuget Fake.Core.Process
    nuget Fake.Core.Trace
    nuget Fake.Core.ReleaseNotes
    nuget Fake.Core.UserInput
    nuget Fake.IO.FileSystem
    nuget Fake.IO.Zip
    nuget Fake.Tools.Git
    nuget Fake.DotNet.Cli
    nuget Fake.DotNet.AssemblyInfoFile
    nuget Fake.DotNet.Testing.Expecto
    nuget Fake.DotNet.Paket
    nuget Fake.BuildServer.GitHubActions
    nuget Fake.Api.GitHub
